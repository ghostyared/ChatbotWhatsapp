# =============================================================================
#  CONFIGURACIÓN DEL CHATBOT — copia este archivo:  cp .env.example .env
#  Luego edita cada valor.  chmod 600 .env   y NUNCA subas .env a git.
#  Los valores que empiezan con CAMBIAR... hacen que la app NO arranque
#  hasta que los reemplaces.  Para generar secretos:  ./scripts/generate-secrets.sh
# =============================================================================

# --- 1. IDENTIDAD (solo presentación) ----------------------------------------
BOT_NAME=EVO                       # nombre del bot (aparece en mensajes y panel)
COMPANY_NAME=Mi Empresa            # nombre de tu empresa/grupo educativo
APP_TIMEZONE=America/Lima          # zona horaria para mostrar horas en el panel
BOT_DEFAULT_GREETING=¡Hola! Soy {{BOT_NAME}}, tu asistente virtual. ¿Con qué institución deseas comunicarte hoy?
HANDOFF_SLA_SECONDS=180            # segundos antes de que el bot retome si ningún asesor responde
USER_INACTIVITY_WARNING_MIN=3      # minutos sin respuesta del usuario antes del aviso de espera
USER_INACTIVITY_CLOSE_MIN=2        # minutos adicionales tras el aviso antes del cierre formal
DRIP_20H_ENABLED=false             # true = recordatorio automático a las 20h a leads tibios/calientes (antes de cerrar ventana 24h)
ATENCION_HORA_INICIO=8             # hora de inicio de atención humana (0-23, zona APP_TIMEZONE)
ATENCION_HORA_FIN=18               # hora de fin de atención humana (0-23, zona APP_TIMEZONE)
ATENCION_DIAS=0,1,2,3,4            # días hábiles (0=Lunes .. 6=Domingo)

# --- 2. WHATSAPP CLOUD API (Meta for Developers) -----------------------------
# Token permanente: de un "Usuario del sistema" en Business Settings (NO el token temporal de 24 h)
TOKEN_PERMANENTE=CAMBIAR_token_permanente_de_meta
# ID del número de teléfono (WhatsApp > Configuración de la API > "Identificador de número de teléfono")
PHONE_ID=CAMBIAR_phone_number_id
# Token de verificación del webhook: lo inventas tú (aleatorio) y lo pegas igual en Meta
WEBHOOK_TOKEN=CAMBIAR_token_verificacion_webhook
# Secreto de la app: Meta for Developers > tu app > Configuración > Básica > "Clave secreta de la app"
# Se usa para validar la firma de cada mensaje que llega al webhook.
APP_SECRET=CAMBIAR_clave_secreta_de_la_app
GRAPH_API_VERSION=v22.0
WA_API_TIMEOUT=10                  # timeout (segundos) al enviar mensaje a Meta
WA_MEDIA_TIMEOUT=30                # timeout (segundos) al descargar foto/PDF de Meta
WEBHOOK_WORKERS=8                  # hilos de fondo por worker para procesar mensajes
WEBHOOK_LOCK_POR_TELEFONO=true     # procesa en serie los mensajes de un mismo teléfono (evita carreras)

# --- 3. PANEL DE ADMINISTRACIÓN ----------------------------------------------
ADMIN_USER=CAMBIAR_usuario_admin
ADMIN_PASS=CAMBIAR_contrasena_larga_minimo_10
ADMIN_NAME=Administrador Principal
# Clave para firmar cookies de sesión (mínimo 32 caracteres aleatorios)
SECRET_KEY=CAMBIAR_clave_aleatoria_de_32_o_mas_caracteres
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=5 per minute; 15 per hour   # límite por IP para el formulario de login
UPLOAD_MAX_MB=5                              # tamaño máximo de archivos Excel subidos al panel (MB)

# --- 4. BASE DE DATOS (PostgreSQL en OTRO contenedor, misma red proxy-net) --------
# Cadena resultante: postgresql://DB_USER:DB_PASS@DB_HOST:DB_PORT/DB_NAME
DB_HOST=CAMBIAR_nombre_del_contenedor_postgres    # p. ej. el container_name de PROD_PostgreSQL (docker ps)
DB_PORT=5432
DB_NAME=chatbot_qa
DB_USER=chatbot_qa
DB_PASS=CAMBIAR_contrasena_de_base_de_datos
# Solo para scripts/desplegar-bd.sh (crear usuario y BD dentro del contenedor de PostgreSQL):
PG_CONTAINER=CAMBIAR_nombre_del_contenedor_postgres   # normalmente igual a DB_HOST
PG_ADMIN_USER=postgres
# Alternativa: una sola cadena (si se define, tiene prioridad sobre las variables DB_*)
# DATABASE_URL=postgresql://usuario:clave@host:5432/nombre
# Parámetros del pool de conexiones PostgreSQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# --- 5. COMPORTAMIENTO DEL BOT -----------------------------------------------
# true  = pide DNI/ID y lo valida contra la tabla de colaboradores antes de mostrar el menú
#         (para bots INTERNOS de personal). Para público/padres/alumnos déjalo en false.
# false = atiende a cualquier número sin pedir ID (las consultas de pagos/notas piden su propia verificación)
REQUIRE_ID_VALIDATION=false
ID_LABEL=DNI                       # cómo se llama el dato (DNI, Código, Cédula...)
ID_LENGTHS=8,9                     # largos válidos del ID
ID_MAX_ATTEMPTS=5                  # intentos fallidos por teléfono antes de bloquear
ID_LOCK_MINUTES=30
MENU_KEYWORDS=hola,inicio,menu,empezar,comenzar,ayuda,info   # palabras que abren el menú
GLOBAL_MENU_KEYWORDS=inicio,menu,home,volver,0,empezar       # comandos globales que siempre regresan al inicio
OPT_OUT_KEYWORDS=baja,stop,no deseo mensajes,no enviar        # palabras de baja automática de campañas HSM (política Meta)
INACTIVE_STATES=inactivo,cesado,baja                          # estados que NO pueden validarse

# --- 5b. CONSULTA DE PAGOS Y NOTAS (tu API académica) ------------------------
# Contrato esperado de la API: ver docs/API_ACADEMICA.md
ACAD_API_URL=https://api.mariategui.edu.pe
# Token/clave de la API. Se envía en el header ACAD_AUTH_HEADER con el prefijo ACAD_AUTH_SCHEME
# (Authorization: Bearer <token>). Para API key: ACAD_AUTH_HEADER=X-API-Key y ACAD_AUTH_SCHEME= (vacío)
ACAD_API_TOKEN=
ACAD_AUTH_HEADER=Authorization
ACAD_AUTH_SCHEME=Bearer
ACAD_API_TIMEOUT=10
# Hosts que pueden recibir ACAD_API_TOKEN si un endpoint de /admin/endpoints no tiene token propio
# (por defecto: el host de ACAD_API_URL). Separa con coma si usas más de uno.
ACAD_TOKEN_HOSTS=api.mariategui.edu.pe
# URL inicial del endpoint notificar_callcenter (opcional)
CALLCENTER_WEBHOOK_URL=
# Rutas de tu API (se concatenan a ACAD_API_URL)
ACAD_PATH_ANIOS=/anios
ACAD_PATH_PERIODOS=/periodos
ACAD_PATH_DEUDAS=/deudas
ACAD_PATH_NOTAS=/notas
# Si no tienes endpoints de años/periodos, fija las listas aquí (separadas por coma):
ACAD_ANIOS_FIJOS=
ACAD_PERIODOS_FIJOS=
# Segundo control además del DNI: fecha_nacimiento | telefono | none  (none NO recomendado)
ACAD_VERIFY_MODE=fecha_nacimiento
# true = las notas solo se muestran si no hay deuda pendiente
ACAD_NOTAS_REQUIERE_PAGOS_AL_DIA=true
ACAD_MAX_ATTEMPTS=5
ACAD_LOCK_MINUTES=30
ACAD_MAX_CONSULTAS_DIA=25          # tope diario de consultas académicas por número de teléfono

# --- 5b-2. CONSULTA DNI EXTERNA (validación de nombres/apellidos en citas y registros) ---
DNI_API_URL=https://www.dsgperutech.com/api-customer/v1/dni/{dni}
DNI_API_TOKEN=                     # token Bearer de tu API de consulta DNI (también editable en /admin/endpoints)
DNI_API_TIMEOUT=8
# SOLO para demos: datos de ejemplo sin API real. NUNCA en producción.
ACAD_API_MOCK=false
FLOW_TIMEOUT_MINUTES=15
MASK_ID_IN_LOGS=true

# --- 5c. COMPROBANTES DE PAGO ----------------------------------------------------
COMPROBANTE_MAX_MB=5
# bd = el archivo se guarda en PostgreSQL (entra en el respaldo de la BD) | disco = carpeta del contenedor (volumen botdata)
COMPROBANTE_ALMACEN=bd
# COMPROBANTES_DIR=/app/data/comprobantes   # no cambiar con Docker (es el volumen "botdata")

# --- 5d. TU API (dominio api.mariategui.edu.pe) --------------------------------------
# Catálogo de sedes (precios, vacantes, aulas), consultado en vivo por la IA. Contrato: docs/API_CATALOGO.md
CAT_API_URL=https://api.mariategui.edu.pe
CAT_API_TOKEN=
CAT_AUTH_HEADER=Authorization
CAT_AUTH_SCHEME=Bearer
CAT_PATH_SEDES=/sedes            # ajusta las rutas a tus endpoints reales
CAT_PATH_OFERTA=/oferta
CAT_PATH_PLANES=/planes-pago      # opcional: planes/promociones de pago (o vienen dentro de /oferta)
CAT_PATH_REQUISITOS=/requisitos  # opcional: requisitos para postular (o vienen dentro de /oferta)
CAT_API_TIMEOUT=8
CAT_CACHE_SEGUNDOS=60
CAT_API_MOCK=false
# Pagos y notas: ver ACAD_API_URL en la sección 5b (puede ser el mismo dominio, con otras rutas)

# --- 5e. ASISTENTE DE VENTAS CON IA ------------------------------------------------
# Proveedores: gemini (Google AI Studio) y openrouter (openrouter.ai). Puedes usar uno de respaldo del otro.
IA_ENABLED=false
IA_PROVIDER=gemini                 # gemini | openrouter
IA_PROVIDER_RESPALDO=openrouter    # opcional: se usa si el principal falla o llega a su límite gratuito
# Google AI Studio: clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opcional: respaldo gratuito ultrarrápido para transcribir notas de voz (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# OpenRouter: clave en https://openrouter.ai/keys ; modelos gratuitos (terminan en :free) en https://openrouter.ai/models
# Elige modelos que soporten "tools"; varios separados por coma (se prueba el siguiente si uno falla)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_REFERER=https://qa-chatbot.uwiener.edu.pe
# Topes de gasto/uso y comportamiento
IA_MAX_MSG_DIA_TEL=30
IA_MAX_LLAMADAS_DIA=2000
IA_HISTORIAL=8
IA_MAX_RESPUESTA=900
IA_PRODUCTOS=Colegio, Instituto Pedagógico   # productos que ofrece el asistente
IA_PERSONALIDAD=cálida, breve y profesional
IA_VERIFICAR=true
# Competidores a no mencionar, separados por coma
IA_BLOQUEAR_NOMBRES=
# La propuesta de venta se edita en el panel (Asistente IA). Aquí solo para textos cortos fijos:
IA_INSTRUCCIONES_EXTRA=
# WhatsApp del asesor (código de país, sin +) si la sede no trae uno propio
ASESOR_TELEFONO=

# --- 6. RED / HTTP -------------------------------------------------------------
SESSION_COOKIE_SECURE=true         # true cuando se accede por HTTPS (recomendado, obligatorio en producción)
SESSION_LIFETIME_MINUTES=480
TRUSTED_PROXIES=1                  # nº de proxies inversos delante de la app (nginx = 1)
RATELIMIT_DEFAULT=300 per hour     # límite general del panel (el webhook de Meta NO tiene límite)
# RATELIMIT_STORAGE_URI=redis://redis:6379   # opcional: contador compartido entre workers
# Cabecera Content-Security-Policy (opcional, recomendada en producción)
CONTENT_SECURITY_POLICY=
APP_PORT=5005                      # puerto interno en el que escucha Gunicorn

# --- 7. RENDIMIENTO Y CONTENEDOR --------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30       # tiempo para esperar que terminen mensajes en curso al reiniciar
LOG_LEVEL=info
APP_MEM_LIMIT=512m                 # límite de memoria del contenedor en docker-compose
APP_CPUS=1.5                       # límite de CPU del contenedor en docker-compose
